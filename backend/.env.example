# Server
PORT=4000
FRONTEND_URL=http://localhost:5173

# Supabase (service role key — server-side only, never expose to the frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Plaid (client secret — server-side only, never expose to the frontend)
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret
PLAID_ENV=sandbox
PLAID_PRODUCTS=transactions,auth,liabilities,investments
PLAID_COUNTRY_CODES=US

# Optional: this backend's own public HTTPS URL (e.g. your Railway domain). When set, Plaid
# Link registers a webhook at <this>/api/webhooks/plaid so transactions/errors push to us
# automatically. Leave unset for local dev — Plaid can't reach localhost.
BACKEND_PUBLIC_URL=https://your-backend.up.railway.app

# Plaid access-token encryption (see PLAID_TOKEN_ENCRYPTION_DESIGN_REVIEW.md).
# One PLAID_TOKEN_KEY_<ID> per key ring entry — the <ID> suffix (verbatim, whatever casing you
# use) becomes the key's logical id, stored in plaid_items.access_token_key_id. Each value must
# be a base64-encoded 32-byte (256-bit) key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# PLAID_TOKEN_CURRENT_KEY_ID must name one of the keys below — it's the one new encryptions use;
# every other configured key stays available only for decrypting rows still tagged with it.
# Local dev: a key here only ever protects sandbox-mode Plaid tokens on your own machine — still
# generate your own (don't reuse this example value), but it's not a secret worth backing up the
# way the staging/production keys are (see the design doc's §5.4/§12 on backing those up before
# ever placing them in Railway).
PLAID_TOKEN_KEY_LOCAL_DEV_V1=replace-with-a-generated-base64-32-byte-key
PLAID_TOKEN_CURRENT_KEY_ID=LOCAL_DEV_V1
